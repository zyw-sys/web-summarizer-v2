# USDA FoodData Central API Key
# 申请地址：https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=your_usda_api_key

# DeepSeek API Key
# 申请地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key

# 可选：deepseek-v4-flash（默认，更快更便宜）或 deepseek-v4-pro
# DEEPSEEK_MODEL=deepseek-v4-flash

# 通义千问（阿里云 DashScope）API Key —— 用于图片识图
# 申请地址：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key

# 可选：qwen-vl-plus（默认）或 qwen-vl-max
# QWEN_VL_MODEL=qwen-vl-plus

# SQLite 数据文件默认保存在 ./data/kazhi.sqlite（无需额外配置）

# 超级管理员（首次启动自动创建/提升）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
